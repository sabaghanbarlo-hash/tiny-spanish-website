{
  // Cloudflare Workers static assets (same hosting style as the Tiny Japanese site).
  // Deploy: npm run build && npx wrangler deploy   (or connect the repo in the Cloudflare dashboard
  // with build command "npm run build" and set SITE_URL to your real address).
  "name": "tiny-spanish",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
